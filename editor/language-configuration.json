{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode/main/src/vs/editor/standalone/common/standaloneLanguages.json",
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?!#).*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:else\\s*:|$)"
  },
  "folding": {
    "offSide": true
  }
}
