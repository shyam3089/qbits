{
  "name": "qbits",
  "version": "0.1.0-beta.1",
  "description": "A small, typed, indentation-based UI language and reactive browser runtime.",
  "keywords": [
    "ui",
    "reactive",
    "compiler",
    "vite"
  ],
  "homepage": "https://github.com/shyam3089/qubits#readme",
  "bugs": "https://github.com/shyam3089/qubits/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shyam3089/qubits.git"
  },
  "author": "Shyam Mohan",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./compiler": {
      "types": "./dist/lib/language/index.d.ts",
      "import": "./dist/lib/language/index.js"
    },
    "./runtime": {
      "types": "./dist/lib/runtime/index.d.ts",
      "import": "./dist/lib/runtime/index.js"
    },
    "./vite": {
      "types": "./dist/lib/tooling/vite.d.ts",
      "import": "./dist/lib/tooling/vite.js"
    }
  },
  "files": [
    "dist/lib",
    "identity.json",
    "docs/agent.md",
    "docs/api.md",
    "docs/architecture.md",
    "docs/commands.md",
    "docs/examples.md",
    "docs/identity.md",
    "docs/limitations.md",
    "docs/local-packages.md",
    "docs/manifest.json",
    "docs/package-managers.md",
    "docs/performance.md",
    "docs/reactivity.md",
    "docs/renaming.md",
    "docs/security.md",
    "docs/syntax.md",
    "SECURITY.md",
    "GOVERNANCE.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/compiler.test.ts tests/phase2.test.ts tests/phase2d.test.ts tests/tooling.test.ts",
    "test:browser": "tsx --test tests/browser.test.ts tests/runtime.test.ts",
    "test:rename": "tsx scripts/check-rename.ts",
    "cli": "node dist/lib/tooling/cli.js",
    "test:docs": "tsx scripts/check-docs.ts",
    "test:external": "tsx scripts/check-external.ts",
    "bench:reactivity": "tsx scripts/benchmark-reactivity.ts",
    "bench:startup": "tsx scripts/benchmark-startup.ts",
    "bench:validator": "tsx scripts/benchmark-validator.ts",
    "bench:frameworks:build": "npm --prefix benchmarks/framework-comparison run build",
    "bench:frameworks:verify": "npm --prefix benchmarks/framework-comparison run verify",
    "bench:frameworks": "npm --prefix benchmarks/framework-comparison run bench"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.5",
    "tsx": "^4.19.4",
    "playwright": "^1.51.1"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "vite": "^6.4.5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "bin": {
    "qb": "dist/lib/tooling/cli.js"
  }
}
