{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "allowJs": true, "resolveJsonModule": true,
    "declaration": true, "outDir": "dist/lib", "rootDir": ".",
    "lib": ["ES2022", "DOM"], "skipLibCheck": true
  },
  "include": ["language", "runtime", "tooling", "identity.json"],
  "exclude": ["tests", "node_modules", "dist"]
}
